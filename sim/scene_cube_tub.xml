<?xml version="1.0"?>
<mujoco model="so101_scene_cube_tub">
  <include file="so101_new_calib.xml"/>

  <option timestep="0.002" iterations="4" ls_iterations="8" integrator="implicitfast">
    <flag eulerdamp="disable"/>
  </option>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="120" elevation="-20" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="256" height="1536"/>
    <material name="table_mat" rgba="0.85 0.75 0.60 1"/>
    <material name="tub_mat"   rgba="0.35 0.35 0.35 1"/>
    <material name="cube_mat"  rgba="0.90 0.12 0.12 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.3 0.3 1.0" dir="-0.3 -0.3 -1"
           diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>

    <!-- Table: top surface at z=0.  size = half-extents.
         TUNE table size to your desk footprint; z offset keeps base clear of mesh. -->
    <geom name="table" type="box" size="0.40 0.30 0.010"
          pos="0.10 0.00 -0.011" material="table_mat"/>

    <!-- Cube: placeholder 40 mm, 20 g.  TUNE size + mass to weighed real cube.
         Diagonal inertia = (1/6) m s^2 for a uniform cube. -->
    <body name="cube" pos="0.22 0.00 0.021">
      <freejoint name="cube_free"/>
      <inertial pos="0 0 0" mass="0.020"
                diaginertia="5.33e-6 5.33e-6 5.33e-6"/>
      <geom name="cube_geom" type="box" size="0.020 0.020 0.020"
            material="cube_mat"
            friction="1.0 0.02 0.005"
            solref="0.005 1" solimp="0.9 0.95 0.001"/>
    </body>

    <!-- Tub: four thin walls + floor, all box primitives.
         Interior ~130 x 130 x 50 mm.  TUNE to real tub. -->
    <body name="tub" pos="0.28 0.15 0.0">
      <geom name="tub_floor"   type="box" size="0.068 0.068 0.002"
            pos="0     0     0.002" material="tub_mat"/>
      <geom name="tub_wall_px" type="box" size="0.002 0.068 0.025"
            pos="0.066  0     0.027" material="tub_mat"/>
      <geom name="tub_wall_nx" type="box" size="0.002 0.068 0.025"
            pos="-0.066 0     0.027" material="tub_mat"/>
      <geom name="tub_wall_py" type="box" size="0.070 0.002 0.025"
            pos="0     0.066 0.027" material="tub_mat"/>
      <geom name="tub_wall_ny" type="box" size="0.070 0.002 0.025"
            pos="0    -0.066 0.027" material="tub_mat"/>
    </body>
  </worldbody>
</mujoco>